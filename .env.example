# =====================================================
# TREASURE CHESS - ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to git

# =====================================================
# SUPABASE CONFIGURATION (required)
# =====================================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Auth setup required in dashboard:
# 1. Authentication → Email → Enable "Email OTP" (magic link)
# 2. Authentication → URL Configuration → Site URL: treasurechess://login
# 3. Authentication → URL Configuration → Redirect URLs: treasurechess://login
# 4. Authentication → Providers → Google: configure OAuth client ID/secret
# 5. Authentication → Providers → Apple: configure Sign In with Apple

# =====================================================
# BLOCKCHAIN CONFIGURATION (Base L2)
# =====================================================
EXPO_PUBLIC_CHAIN_ID=8453
EXPO_PUBLIC_RPC_URL=https://mainnet.base.org
EXPO_PUBLIC_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
EXPO_PUBLIC_VAULT_ADDRESS=0x_YOUR_PLATFORM_VAULT_ADDRESS

# For testnet (Base Sepolia)
# EXPO_PUBLIC_CHAIN_ID=84532
# EXPO_PUBLIC_RPC_URL=https://sepolia.base.org
# EXPO_PUBLIC_USDC_CONTRACT=0x_TESTNET_USDC_ADDRESS

# =====================================================
# FIAT ON-RAMP (MoonPay/Transak)
# =====================================================
EXPO_PUBLIC_MOONPAY_API_KEY=your-moonpay-api-key
EXPO_PUBLIC_MOONPAY_WEBHOOK_SECRET=your-moonpay-webhook-secret
EXPO_PUBLIC_TRANSAK_API_KEY=your-transak-api-key

# =====================================================
# PUSH NOTIFICATIONS
# =====================================================
EXPO_PUBLIC_EXPO_PROJECT_ID=your-expo-project-id

# =====================================================
# FEATURE FLAGS
# =====================================================
EXPO_PUBLIC_ENABLE_WAGERING=false
EXPO_PUBLIC_ENABLE_TOURNAMENTS=false
EXPO_PUBLIC_ENABLE_LIVESTREAM=false
EXPO_PUBLIC_ENABLE_CHAT=false

# =====================================================
# DEVELOPMENT
# =====================================================
EXPO_PUBLIC_API_URL=http://localhost:54321/functions/v1
EXPO_PUBLIC_DEBUG_MODE=true

# =====================================================
# EDGE FUNCTION SECRETS (set in Supabase dashboard, not .env)
# =====================================================
# SUPABASE_SERVICE_ROLE_KEY=...
# BACKEND_SIGNER_PRIVATE_KEY=vault-wallet-private-key
# BASE_RPC_URL=https://mainnet.base.org
# USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# CHAIN_ID=8453
