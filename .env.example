# =====================================================
# TREASURE CHESS - ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to git

# =====================================================
# SUPABASE CONFIGURATION (required)
# =====================================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Auth setup required in dashboard:
# 1. Authentication → Email → Enable "Email OTP" (magic link)
# 2. Authentication → URL Configuration → Site URL: treasurechess://login
# 3. Authentication → URL Configuration → Redirect URLs: treasurechess://login
# 4. Authentication → Providers → Google: configure OAuth client ID/secret
# 5. Authentication → Providers → Apple: configure Sign In with Apple

# =====================================================
# BLOCKCHAIN CONFIGURATION (Base L2)
# =====================================================
EXPO_PUBLIC_CHAIN_ID=8453
EXPO_PUBLIC_RPC_URL=https://mainnet.base.org
EXPO_PUBLIC_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
EXPO_PUBLIC_VAULT_ADDRESS=0x_YOUR_PLATFORM_VAULT_ADDRESS

# For testnet (Base Sepolia)
# EXPO_PUBLIC_CHAIN_ID=84532
# EXPO_PUBLIC_RPC_URL=https://sepolia.base.org
# EXPO_PUBLIC_USDC_CONTRACT=0x_TESTNET_USDC_ADDRESS

# =====================================================
# FIAT ON-RAMP (MoonPay/Transak)
# =====================================================
EXPO_PUBLIC_MOONPAY_API_KEY=your-moonpay-api-key
EXPO_PUBLIC_TRANSAK_API_KEY=your-transak-api-key

# =====================================================
# PUSH NOTIFICATIONS
# =====================================================
EXPO_PUBLIC_EXPO_PROJECT_ID=your-expo-project-id

# =====================================================
# FEATURE FLAGS
# Set all to true for production. false = feature hidden from users.
# =====================================================
EXPO_PUBLIC_ENABLE_WAGERING=true
EXPO_PUBLIC_ENABLE_TOURNAMENTS=true
EXPO_PUBLIC_ENABLE_LIVESTREAM=false
EXPO_PUBLIC_ENABLE_CHAT=false

# =====================================================
# DEVELOPMENT
# =====================================================
EXPO_PUBLIC_API_URL=http://localhost:54321/functions/v1
EXPO_PUBLIC_DEBUG_MODE=false

# =====================================================
# EDGE FUNCTION SECRETS
# Set these in the Supabase dashboard under Project Settings → Edge Functions → Secrets
# Do NOT put real values here — this file is committed to git
# =====================================================

# REQUIRED — vault USDC signing key (never expose; used by relay-transaction, process-withdrawals)
# BACKEND_SIGNER_PRIVATE_KEY=0x...

# REQUIRED — random secret shared between cron scheduler and edge functions
# Used by: deposit-monitor, process-withdrawals, process-house-payout, process-reward-payout, matchmaking
# Generate with: openssl rand -hex 32
# CRON_SECRET=...

# REQUIRED — address must match a row in the platform_config table (get_vault_address RPC)
# PLATFORM_VAULT_ADDRESS=0x...

# Blockchain RPC (defaults to https://mainnet.base.org if not set)
# BASE_RPC_URL=https://mainnet.base.org
# USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Payment webhook secrets (set these or webhooks will return 503)
# MOONPAY_WEBHOOK_SECRET=...
# TRANSAK_WEBHOOK_SECRET=...

# Streaming (optional — only needed if ENABLE_LIVESTREAM=true)
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_STREAM_TOKEN=...
# MUX_TOKEN_ID=...
# MUX_TOKEN_SECRET=...
# STREAM_TOKEN_ENCRYPTION_KEY=...

# Social integrations (optional)
# TIKTOK_CLIENT_KEY=...
# TIKTOK_CLIENT_SECRET=...
# TWITCH_CLIENT_ID=...
# TWITCH_CLIENT_SECRET=...
