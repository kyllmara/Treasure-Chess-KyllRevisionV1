# Deployer wallet private key (with MATIC for gas)
DEPLOYER_PRIVATE_KEY=0x...

# Backend signer - this wallet signs game results
# Generate a new wallet for this, store private key securely
BACKEND_SIGNER_ADDRESS=0x...

# Platform vault - receives 10% fees from game wins
PLATFORM_VAULT_ADDRESS=0x...

# RPC URLs
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# For contract verification
POLYGONSCAN_API_KEY=...

# Optional
ALCHEMY_API_KEY=...
REPORT_GAS=false
FORK_ENABLED=false
